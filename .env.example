APP_NAME=Harsimranjit Portfolio API
ENVIRONMENT=development
# MongoDB Atlas connection string, e.g.:
# mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/portfolio?appName=Cluster0
MONGODB_URI=
ADMIN_API_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
# Generate with: python -m app.scripts.hash_password
ADMIN_PASSWORD_HASH=
CORS_ORIGINS=http://localhost:5173,https://your-domain.vercel.app
PUBLIC_BASE_URL=http://localhost:8000
# Use local for development and r2 for production.
STORAGE_PROVIDER=local
UPLOAD_DIR=storage
MAX_UPLOAD_MB=10
R2_ACCOUNT_ID=c7754ce4eac2f7ebc4bb5d9bc25bc2d3
R2_ACCESS_KEY_ID=be45b10556c2acf9e8abad4b7fa7b05e
R2_SECRET_ACCESS_KEY=db27d95cbac4d60ffa432c24b91ced8bac1bbc9069e1480c5eee68d2be739430
R2_BUCKET_NAME=portfolio-media
R2_PUBLIC_BASE_URL=https://pub-4db5c039e74d472290704be382f8525b.r2.dev
# Gmail: smtp.gmail.com with port 587 and STARTTLS. Use an App Password, not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO=
SMTP_USE_TLS=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180
RAG_TOP_K=6
RAG_MIN_SCORE=0.18
