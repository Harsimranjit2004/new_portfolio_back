# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python caches and compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/

# Test and coverage output
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/
wheels/

# Local databases and backups
*.db
*.db-*
*.sqlite
*.sqlite3
*.bak
*.backup

# Local uploaded files; retain the directory placeholder
storage/*
!storage/.gitkeep

# Logs and runtime files
*.log
*.pid
*.sock

# Operating-system files
.DS_Store
Thumbs.db

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Local tooling
.ipynb_checkpoints/
.python-version.local
